# 围物为心 环境变量模板
# 复制此文件为 .env 并填入实际值

# 数据库
DATABASE_URL="postgresql://weiwuweixin:changeme@localhost:5432/weiwuweixin?schema=public"
# 嵌入式 PG（start-pg.cjs/mjs）独立使用的密码
PG_PASSWORD=changeme

# Redis
REDIS_URL="redis://localhost:6379"

# 服务器
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# MinIO 对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=weiwuweixin

# JWT
JWT_SECRET=changeme

# 管理员账号（用于 seed-admin.ts 初始化）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
